{
  "name": "moodmarble",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "test:backend": "pnpm --dir apps/backend test",
    "test:mobile": "node ./scripts/test-mobile.cjs",
    "e2e:android:preflight": "pnpm --dir apps/mobile e2e:android:preflight",
    "e2e:android:metro": "pnpm --dir apps/mobile e2e:android:metro",
    "e2e:android:build": "pnpm --dir apps/mobile e2e:android:build",
    "e2e:android:test": "pnpm --dir apps/mobile e2e:android:test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1"
  },
  "lint-staged": {
    "apps/mobile/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/backend/**/*.ts": [
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "i18next": "^26.3.3",
    "lucide-react-native": "^1.22.0",
    "react-i18next": "^17.0.8",
    "zustand": "^5.0.14"
  }
}
