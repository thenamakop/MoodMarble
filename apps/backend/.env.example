# ---------------------------------------------------------------------------
# Backend environment variables — copy to .env (root or apps/backend/) and
# replace ALL placeholder values before use.
#
# LOCAL DEV ONLY: the values below are safe for a machine-local Docker setup.
# Use strong, unique secrets for any non-local deployment.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose.yml default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/moodmarble

# Redis connection string (matches docker-compose.yml default)
REDIS_URL=redis://localhost:6379

# Shared JWT signing secret — used for device, manager, and admin tokens.
# Must be at least 32 characters and must NOT look like a JWT (no dots).
JWT_SECRET=local-dev-jwt-secret-change-me

# Optional bootstrap secret for future automated admin provisioning.
ADMIN_BOOTSTRAP_SECRET=local-admin-bootstrap-secret-change-me

# Admin account credentials — consumed only by `pnpm seed:admin`.
# ADMIN_PASSWORD must be at least 12 characters.
# ⚠️  Change these before running seed:admin in any non-local environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Server bind address and port (defaults are fine for local dev).
HOST=0.0.0.0
PORT=3000
