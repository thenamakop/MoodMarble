# ---------------------------------------------------------------------------
# Mobile environment variables — copy to .env.local (git-ignored) and
# set EXPO_PUBLIC_API_BASE_URL when connecting to a physical device or a
# custom backend host.
#
# Leave EXPO_PUBLIC_API_BASE_URL empty (or omit the file entirely) to use
# the platform default:
#   - Android emulator  → http://10.0.2.2:3000
#   - iOS simulator / web → http://127.0.0.1:3000
# ---------------------------------------------------------------------------

# URL of the backend API — required for physical device testing.
# Replace YOUR_LAN_IP with your machine's local network IP address.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_BASE_URL=

# Production backend URL — set as an EAS Secret, not here.
# Run: eas secret:create --name EXPO_PUBLIC_API_BASE_URL \
#        --value https://your-railway-app.up.railway.app
# The value is injected into the EAS build automatically.
# Leave empty here — this file is for local dev documentation only.
