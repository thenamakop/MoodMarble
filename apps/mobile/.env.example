# ---------------------------------------------------------------------------
# Mobile environment variables — copy to .env.local inside apps/mobile/.
# This is the single source of truth for local mobile configuration.
#
# Expo loads .env files from apps/mobile/, not from the repo root.
# The root .env.local is for backend development only.
#
# Set EXPO_PUBLIC_API_BASE_URL only when connecting to a physical device or
# a custom backend host. For emulators and simulators, leave it empty.
#
# Leave EXPO_PUBLIC_API_BASE_URL empty (or omit the file entirely) to use
# the platform default:
#   - Android emulator  → http://10.0.2.2:3000
#   - iOS simulator / web → http://127.0.0.1:3000
#
# WARNING: A stale LAN IP here (e.g. 192.168.x.x) will make the emulator or
# simulator time out with an AbortError. Clear it to restore the default.
# ---------------------------------------------------------------------------

# URL of the backend API — required for physical device testing only.
# Replace YOUR_LAN_IP with your machine's local network IP address.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_BASE_URL=

# Production backend URL — set as an EAS Secret, not here.
# Run: eas secret:create --name EXPO_PUBLIC_API_BASE_URL \
#        --value https://your-railway-app.up.railway.app
# The value is injected into the EAS build automatically.
# Leave empty here — this file is for local dev documentation only.

# Sentry DSN for React Native crash reporting.
# EXPO_PUBLIC_ prefix makes it available in the Expo JS bundle.
# Leave empty for local development.
# For EAS builds, add it as an EAS Secret (not here):
#   eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value "https://..."
EXPO_PUBLIC_SENTRY_DSN=
