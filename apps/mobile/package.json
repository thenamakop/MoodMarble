{
  "name": "moodmarble",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "^56.0.3",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.3.3",
    "lucide-react-native": "^1.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "victory": "^37.3.6",
    "victory-native": "^37.3.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "detox": "^20.41.0",
    "eas-cli": "^20.5.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "expect": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "jsonwebtoken": "^9.0.3",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --clear --host localhost --android",
    "ios": "expo start --clear --host localhost --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "e2e:android:preflight": "node ./scripts/android-e2e-preflight.cjs",
    "e2e:android:start": "expo start --dev-client --port 8081 --host localhost",
    "e2e:android:metro": "expo start --dev-client --clear --host localhost",
    "e2e:android:build": "detox build -c android.emu.debug",
    "e2e:android:test": "node ./scripts/android-e2e-preflight.cjs && detox test -c android.emu.debug --loglevel verbose",
    "e2e:android:test:headed": "node ./scripts/android-e2e-preflight.cjs && detox test -c android.emu.debug --loglevel verbose",
    "e2e:android:test:headless": "node ./scripts/android-e2e-preflight.cjs && detox test -c android.emu.debug --headless --loglevel verbose"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/global\\.css$": "<rootDir>/test/__mocks__/styleMock.ts",
      "\\.css$": "<rootDir>/test/__mocks__/styleMock.ts",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
